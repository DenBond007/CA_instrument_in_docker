# LAN IPv4 адрес самой Ubuntu-машины. Замените при необходимости.
BIND_IP=192.168.88.42

# Стартовая страница: first-run.sh соберёт актуальный каталог из исходников.
# Опубликованный 1.0.0 содержит старые ссылки без штатного AI draw.io.
PORTAL_IMAGE=local/analyst-portal:dev
PORTAL_PORT=18080
# Необязательно: DNS/IP, по которому браузеры открывают инструменты.
# PORTAL_HOST=analyst.example.internal
# PORTAL_TITLE=Инструменты аналитика
# Ссылка не устанавливает Portainer; скройте её, если он не нужен.
PORTAL_SHOW_PORTAINER=true
# Необязательно: Portainer на другом сервере или за HTTPS proxy.
# PORTAINER_URL=https://portainer.example.internal

# Готовый кастомный Mermaid: адрес Kroki задаётся при запуске, без пересборки.
MERMAID_IMAGE=ghcr.io/denbond007/mermaid-live-editor-runtime:1.0.0
# Необязательно: полный адрес для браузеров; иначе Compose использует BIND_IP/KROKI_PORT.
# KROKI_URL=https://kroki.example.internal

# Внешние порты (по умолчанию соответствуют предыдущей инструкции).
PORTAINER_PORT=9443
MERMAID_PORT=18081
PLANTUML_PORT=18082
SWAGGER_EDITOR_PORT=18083
SWAGGER_UI_PORT=18084
DRAWIO_PORT=18085
AI_DRAWIO_PORT=18088
ASYNCAPI_PORT=18086
KROKI_PORT=18087

# Next AI Draw.io: OpenAI-совместимый API локальной LLM, DeepSeek или OpenAI.
# Ключ передаётся только серверу AI-редактора, не статическому порталу.
AI_DRAWIO_IMAGE=ghcr.io/dayuanjiang/next-ai-draw-io:0.5.0
AI_DRAWIO_BASE_URL=http://host.docker.internal:11434/v1
# Точный ID из GET /v1/models; задайте перед первой генерацией.
AI_DRAWIO_MODEL=
# Для Ollama без авторизации можно указать ollama; настоящий ключ храните только в .env.
AI_DRAWIO_API_KEY=
AI_DRAWIO_MAX_OUTPUT_TOKENS=8192

# Штатный AI обычного draw.io включён сразу и использует локальный прокси.
# По умолчанию наследует AI_DRAWIO_BASE_URL/MODEL/API_KEY/MAX_OUTPUT_TOKENS выше.
# Для запуска без LLM задайте false. Конфигурацию создаёт first-run.sh.
DRAWIO_AI_ENABLED=true
DRAWIO_LANG=ru
# Независимая модель для обычного draw.io (необязательно):
# DRAWIO_AI_BASE_URL=http://192.168.88.42:8888/v1
# DRAWIO_AI_MODEL=your-model-id
# DRAWIO_AI_API_KEY=
# DRAWIO_AI_MAX_TOKENS=8192
